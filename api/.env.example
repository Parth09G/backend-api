# Copy to api/.env for local runs (never commit .env). In Railway, set these as service variables.

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# billing_api role via the Supabase *session* pooler (Dashboard > Connect > Session pooler).
# User is "billing_api.<project-ref>"; password is the one you set with ALTER ROLE.
DATABASE_URL=postgresql://billing_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local Supabase stack (`supabase start`):
# DATABASE_URL=postgresql://billing_api:<password>@127.0.0.1:54322/postgres?sslmode=disable

SUPABASE_URL=https://<project-ref>.supabase.co
# Local: SUPABASE_URL=http://127.0.0.1:54321

# Server-side only: inviting users (Auth admin) and the private Storage bucket. Never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# Page the invite and password-reset emails link to (the web app).
AUTH_REDIRECT_URL=http://localhost:5173/reset-password

# 32 random bytes, base64. Encrypts the GSP/ASP credentials stored in shop_settings.
# Generate: openssl rand -base64 32   (or PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 })))
APP_ENCRYPTION_KEY=

# Comma-separated; production = the website domain only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Process roles. Development: both true in one process.
RUN_API=true
RUN_WORKER=true
RIVER_MIGRATE=true
